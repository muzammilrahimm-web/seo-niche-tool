{
  "manifest_version": 3,
  "name": "Niche Finder – SEO Niche & Keyword Research",
  "short_name": "Niche Finder",
  "version": "1.0.0",
  "description": "Side panel mein SEO niche aur keyword research: Google, YouTube aur DuckDuckGo se long-tail keywords, niche score aur competition.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Niche Finder kholein",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage", "contextMenus"],
  "host_permissions": [
    "https://suggestqueries.google.com/*",
    "https://duckduckgo.com/*"
  ]
}
